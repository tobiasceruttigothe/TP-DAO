# Puertos de la PC donde se publican la API y la base (docker compose)
API_PORT=8000
DB_PORT=5432
# Si se cambia WEB_PORT, agregar http://localhost:<puerto> a CORS_ORIGENES
WEB_PORT=3000
PGADMIN_PORT=5050
MAILPIT_PORT=8025

DATABASE_URL=postgresql+psycopg2://biblioteca:biblioteca@localhost:5432/biblioteca
TEST_DATABASE_URL=postgresql+psycopg2://biblioteca:biblioteca@localhost:5432/biblioteca_test

# Origenes del frontend habilitados (CORS), separados por coma
CORS_ORIGENES=http://localhost:3000,http://localhost:5173,http://localhost:4200

DIAS_PRESTAMO=14
MAX_PRESTAMOS_ACTIVOS=3
DIAS_VALIDEZ_RESERVA=3
# Multas: hasta MULTA_DIAS_LEVES de atraso se cobra MULTA_MONTO_DIARIO por dia (leve);
# desde el dia siguiente, MULTA_MONTO_DIARIO_GRAVE (grave). Se suma un cargo si se devuelve mal.
MULTA_MONTO_DIARIO=500
MULTA_MONTO_DIARIO_GRAVE=1000
MULTA_DIAS_LEVES=7
MULTA_CARGO_DANADO=5000
MULTA_CARGO_DESTRUIDO=20000
# Dias de atraso para inhabilitar automaticamente al socio
DIAS_ATRASO_INHABILITACION=30

# Proceso de vencimientos (reservas no retiradas e inhabilitacion por atraso)
PROCESO_AUTOMATICO=true
INTERVALO_PROCESO_MINUTOS=60

# Sesiones (JWT). En una instalacion real, poner un texto largo y secreto
JWT_SECRETO=cambiar-este-secreto-en-el-env-para-produccion
JWT_MINUTOS=480
# Administrador que se crea al arrancar si no hay ninguno
ADMIN_EMAIL=admin@example.com
ADMIN_CONTRASENA=admin123

# Direccion del frontend, para los enlaces de los correos
URL_FRONTEND=http://localhost:3000
# Dias de anticipacion del aviso "tu prestamo vence pronto"
DIAS_AVISO_VENCIMIENTO=2

# Correo. Por defecto todo va a Mailpit (bandeja de prueba en http://localhost:8025).
# Con docker compose el host es "mailpit"; corriendo la API fuera de Docker, "localhost".
CORREO_MODO=smtp
SMTP_HOST=mailpit
SMTP_PUERTO=1025
SMTP_TLS=false
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=Red de Bibliotecas <no-responder@example.com>

# Para mandar correos de verdad con Gmail (ver docs/despliegue-local.md), reemplazar por:
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_TLS=true
# SMTP_USUARIO=tu.cuenta@gmail.com
# SMTP_CONTRASENA=la-contrasena-de-aplicacion-de-16-letras
# CORREO_REMITENTE=Red de Bibliotecas <tu.cuenta@gmail.com>
# ADMIN_EMAIL=tu.cuenta@gmail.com   (si no, los avisos al admin rebotan)
