# Puertos de la PC donde se publican la API y la base (docker compose)
API_PORT=8000
DB_PORT=5432
# Si se cambia WEB_PORT, agregar http://localhost:<puerto> a CORS_ORIGENES
WEB_PORT=3000
PGADMIN_PORT=5050

DATABASE_URL=postgresql+psycopg2://biblioteca:biblioteca@localhost:5432/biblioteca
TEST_DATABASE_URL=postgresql+psycopg2://biblioteca:biblioteca@localhost:5432/biblioteca_test

# Origenes del frontend habilitados (CORS), separados por coma
CORS_ORIGENES=http://localhost:3000,http://localhost:5173,http://localhost:4200

DIAS_PRESTAMO=14
MAX_PRESTAMOS_ACTIVOS=3
DIAS_VALIDEZ_RESERVA=3
# Multas: hasta MULTA_DIAS_LEVES de atraso se cobra MULTA_MONTO_DIARIO por dia (leve);
# desde el dia siguiente, MULTA_MONTO_DIARIO_GRAVE (grave). Se suma un cargo si se devuelve mal.
MULTA_MONTO_DIARIO=500
MULTA_MONTO_DIARIO_GRAVE=1000
MULTA_DIAS_LEVES=7
MULTA_CARGO_DANADO=5000
MULTA_CARGO_DESTRUIDO=20000
# Dias de atraso para inhabilitar automaticamente al socio
DIAS_ATRASO_INHABILITACION=30

# Proceso de vencimientos (reservas no retiradas e inhabilitacion por atraso)
PROCESO_AUTOMATICO=true
INTERVALO_PROCESO_MINUTOS=60
